# LLM provider: openai | anthropic | openai_compatible
LLM_PROVIDER=openai

# Model name (examples: gpt-4o-mini, gpt-4o, claude-3-5-sonnet-latest)
LLM_MODEL=gpt-4o-mini

# Required for OpenAI (or OpenAI-compatible endpoints)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: custom OpenAI-compatible base URL (e.g. Azure, Groq, local gateway)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Agent behavior
AGENT_MAX_STEPS=30
AGENT_TEMPERATURE=0.1
CLONE_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=30
