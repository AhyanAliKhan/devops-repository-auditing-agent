# LLM provider: openai | google | gemini | anthropic | openai_compatible
LLM_PROVIDER=google

# Model name examples:
#   google/gemini: gemini-3.5-flash, gemini-3.8-flash, gemini-2.5-flash
#   openai: gpt-4o-mini, gpt-4o
#   anthropic: claude-3-5-sonnet-latest
LLM_MODEL=gemini-3.5-flash-lite

# Required when LLM_PROVIDER=google or gemini
GOOGLE_API_KEY=your-google-api-key-here
# Alias also accepted:
# GEMINI_API_KEY=your-google-api-key-here

# Required for OpenAI (or OpenAI-compatible endpoints)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: override OpenAI-compatible base URL
# For Gemini the default is:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Agent behavior
AGENT_MAX_STEPS=30
AGENT_TEMPERATURE=0.1
CLONE_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=30
# Seconds between LLM calls (use ~13 on Gemini free tier / 5 RPM)
LLM_MIN_REQUEST_INTERVAL=13
